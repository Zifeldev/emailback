# Email Service Configuration Template
# Copy this file to .env and fill in your values

# Database
DB_USER=emailback
DB_PASSWORD=your_secure_password_here
DB_NAME=emailback

# HTTP
REQUEST_TIMEOUT=30s

# AI Configuration
AI_ENABLED=true
AI_TIMEOUT=1m

# AI Summarization Models (JSON format)
# Supports multiple languages - add or remove languages as needed
AI_SUM_MODELS={"en":"sshleifer/distilbart-cnn-12-6","ru":"RussianNLP/FRED-T5-Summarizer","de":"Einmalumdiewelt/T5-Base_GNAD","fr":"plguillou/t5-base-fr-sum-cnndm","es":"ELiRF/t5-base-Fine-Tuning-summarization-spanish"}

# AI Classification Model
AI_CLS_MODEL=facebook/bart-large-mnli

# Hugging Face API Token (required for AI features)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Redis
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Additional variables for Production only
# (copy to .env.prod if using production mode)
# ============================================

# Application
STRICT=true
LOG_LEVEL=warn
HTTP_HOST=:8080

# Database Connection Pool
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Redis Configuration
REDIS_ENABLED=true
REDIS_ADDR=redis:6379
REDIS_PREFIX=emailback:
REDIS_TTL=5m

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INTERVAL=5m
RATE_LIMIT_MAX=100

# Notes:
# - For production, store DB_PASSWORD in ../secrets/db_password file instead
# - Never commit .env files to version control
# - Use strong passwords for production environments
# - Update HF_TOKEN with your personal Hugging Face token

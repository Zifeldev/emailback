# Example environment variables for the Emailback project
# Copy this file to `.env` (or read values into your environment) and adjust values before running docker-compose.

# Database
DB_USER=postgres
# DB_PASSWORD should be set to a secret value in production
DB_PASSWORD=postgres
DB_NAME=emailback
AUTH_DB_NAME=authdb

# Connection pool
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=emailback:
REDIS_TTL=5m

# Application / HTTP
REQUEST_TIMEOUT=30s
AUTH_HOST_PORT=8081
APP_HOST_PORT=8080
AIWORKER_HOST_METRICS_PORT=9092

# AI / HF
AI_ENABLED=true
AI_TIMEOUT=30s
# AI_SUM_MODELS: provider-specific mapping (fill as needed)
AI_SUM_MODELS=
AI_CLS_MODEL=facebook/bart-large-mnli
HF_TOKEN=

# JWT secrets (replace with secure values)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRATION=3600s
JWT_REFRESH_EXPIRATION=24h
JWT_ISSUER=emailback-auth

# Monitoring / images
PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_HOST_PORT=9090
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=3000

# Optional overrides
PROMETHEUS_HOST_PORT=9090
